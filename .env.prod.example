# Variáveis do docker-compose.prod.yml. No Coolify, cadastre estas mesmas
# chaves na aba de environment do projeto — não suba este arquivo preenchido.

# Postgres (container local; o volume cifrao-pgdata guarda os dados)
POSTGRES_USER=cifrao
POSTGRES_DB=cifrao
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Better Auth: segredo de assinatura e a URL pública do app
BETTER_AUTH_SECRET=gere-com-openssl-rand-base64-32
BETTER_AUTH_URL=https://cifrao.seu-dominio.com

# Registro só é aberto para criar o primeiro usuário. Depois, false.
REGISTRATION_OPEN=false

# Porta publicada do web (o proxy do Coolify aponta para ela)
WEB_PORT=3000

# Limite do corpo do upload de extrato (Fase 6)
API_BODY_LIMIT=12mb
