# Postgres (dev via docker-compose, publicado na 55432 para não colidir com um
# Postgres nativo nas 5432/5433). Em produção (Neon/Supabase), DATABASE_URL aponta
# para o pooler e DIRECT_URL para a conexão direta (migrations).
DATABASE_URL="postgresql://cifrao:cifrao@localhost:55432/cifrao?schema=public"
DIRECT_URL="postgresql://cifrao:cifrao@localhost:55432/cifrao?schema=public"

# API (NestJS)
API_PORT=3001
# Base do Better Auth (Next) para o Nest buscar o JWKS e validar o JWT.
BETTER_AUTH_URL="http://localhost:3000"

# Web (Next) -> destino do proxy /api/* e do fetch server-side do health
API_INTERNAL_URL="http://localhost:3001"

# Auth (Better Auth, roda no Next)
# Gere um segredo forte: `openssl rand -base64 32`
BETTER_AUTH_SECRET="troque-por-um-segredo-forte"
# Registro: liberado só para o 1º usuário. Deixe "false" para manter fechado
# depois disso; "true" reabre temporariamente o cadastro.
REGISTRATION_OPEN="false"

# Limite de tentativa nas rotas de autenticação (login, cadastro e 2FA).
# Fica LIGADO por padrão, inclusive em dev — limite que não roda em dev é limite
# que ninguém testa. Use "false" para desligar durante um trabalho local.
AUTH_RATE_LIMIT="true"
# Faixas (CIDR) do proxy à frente do app, separadas por vírgula. Em dev não há
# proxy, então fica vazio. LEIA apps/web/src/lib/rate-limit.ts antes de mexer:
# vazio atrás de proxy deixa um atacante empurrar o limite para um balde único.
TRUSTED_PROXIES=""
