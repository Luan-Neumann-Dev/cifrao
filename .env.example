# Postgres (dev via docker-compose). Em produção (Neon/Supabase),
# DATABASE_URL aponta para o pooler e DIRECT_URL para a conexão direta (migrations).
DATABASE_URL="postgresql://cifrao:cifrao@localhost:5432/cifrao?schema=public"
DIRECT_URL="postgresql://cifrao:cifrao@localhost:5432/cifrao?schema=public"

# API (NestJS)
API_PORT=3001

# Web (Next) -> destino do proxy /api/* e do fetch server-side do health
API_INTERNAL_URL="http://localhost:3001"
