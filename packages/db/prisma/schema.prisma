// Schema do Cifrão.
//
// Fase 1: autenticação do Better Auth (User, Session, AuthAccount, Verification,
// TwoFactor, Jwks). O model de credenciais é `AuthAccount` para não colidir com
// a conta bancária `Account`.
// Fase 2: núcleo de domínio (Account, Category, Tag, Transaction, splits).
// Fase 3: cartões e faturas (CreditCard, Invoice, Purchase) + campos de cartão em
// Transaction (creditCardId/invoiceId/purchaseId/parcelas).
// Fase 5: recorrências (RecurringRule + recurringRuleId em Transaction), orçamento
// (Budget) e metas (Goal — aponta para saldo existente, nunca cria saldo).
// Fase 6: importação (ImportBatch/ImportRow como staging — nada vira lançamento
// antes da confirmação) e CategoryRule (regras aprendidas de categorização).
// Fase 8: investimentos (Investment, InvestmentTransaction, PriceHistory,
// AllocationTarget). Aportar move dinheiro de uma conta para a posição, então
// nenhum real é contado duas vezes no patrimônio.
// Fase 9: preferências de aviso no User e `RestoreJob` (progresso da restauração
// de backup). O export lê o banco e a restauração grava nas tabelas existentes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Autenticação (Better Auth) ──────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Plugin twoFactor
  twoFactorEnabled Boolean? @default(false)

  // Campos de domínio do User (Seção 6) preservados sobre o schema do Better Auth
  theme       String? @default("system")
  accentColor String? @default("#820AD1")

  // Fase 9: preferências de aviso. Não há e-mail nem push — os avisos são
  // derivados dos dados que já existem e mostrados dentro do app.
  notifyInvoiceDue     Boolean @default(true)
  notifyBudgetExceeded Boolean @default(true)
  notifyGoalReached    Boolean @default(true)
  notifyForecastDue    Boolean @default(true)
  /// Antecedência, em dias, para avisar de vencimento e de previsto.
  notifyDaysBefore     Int     @default(3)

  sessions   Session[]
  accounts   AuthAccount[]
  twofactors TwoFactor[]

  // Dados de domínio. Cascade: excluir a conta apaga tudo que é do usuário
  // (a "zona de risco" da Fase 9 depende disso).
  bankAccounts      Account[]
  categories        Category[]
  tags              Tag[]
  transactions      Transaction[]
  creditCards       CreditCard[]
  invoices          Invoice[]
  purchases         Purchase[]
  recurringRules    RecurringRule[]
  importBatches     ImportBatch[]
  categoryRules     CategoryRule[]
  budgets           Budget[]
  investments       Investment[]
  allocationTargets AllocationTarget[]
  goals             Goal[]
  restoreJobs       RestoreJob[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model TwoFactor {
  id                      String  @id
  secret                  String
  backupCodes             String
  verified                Boolean @default(false)
  failedVerificationCount Int     @default(0)
  userId                  String
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Jwks {
  id         String   @id
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
}

// ─── Domínio (Fase 2) ─────────────────────────────────────────────────────────

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  INVESTMENT
}

enum CategoryKind {
  EXPENSE
  INCOME
  BOTH
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  CLEARED
  FORECAST
}

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  type         AccountType
  balanceCents BigInt      @default(0)
  color        String?
  institution  String?
  archived     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  transactions    Transaction[] @relation("AccountTransactions")
  transfersFrom   Transaction[] @relation("TransferFrom")
  transfersTo     Transaction[] @relation("TransferTo")
  defaultForCards CreditCard[]  @relation("CardDefaultPayment")

  recurringRules  RecurringRule[]         @relation("RecurringAccount")
  recurringFrom   RecurringRule[]         @relation("RecurringFrom")
  recurringTo     RecurringRule[]         @relation("RecurringTo")
  goals           Goal[]                  @relation("GoalAccount")
  importBatches   ImportBatch[]
  investmentMoves InvestmentTransaction[]

  @@index([userId])
  @@index([userId, archived])
}

model Category {
  id String @id @default(cuid())

  /// NULL = categoria universal, compartilhada por todos os usuários (vem do
  /// seed e é somente-leitura). Preenchido = categoria criada pelo usuário.
  /// Decisão do dono: não duplicar as 49 padrão por usuário.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  icon     String?
  color    String?
  kind     CategoryKind @default(BOTH)
  parentId String?
  parent   Category?    @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[]   @relation("CategoryChildren")

  transactions   Transaction[]
  splits         TransactionSplit[]
  purchases      Purchase[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  importRows     ImportRow[]
  categoryRules  CategoryRule[]

  createdAt DateTime @default(now())

  @@index([userId])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  color        String?
  transactions TransactionTag[]
  createdAt    DateTime         @default(now())

  @@unique([userId, name])
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                TransactionType
  amountCents         BigInt
  date                DateTime
  description         String
  originalDescription String?
  status              TransactionStatus @default(CLEARED)
  notes               String?
  isReimbursable      Boolean           @default(false)
  reimbursedAt        DateTime?

  accountId String?
  account   Account? @relation("AccountTransactions", fields: [accountId], references: [id])

  fromAccountId String?
  fromAccount   Account? @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String?
  toAccount     Account? @relation("TransferTo", fields: [toAccountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Cartão de crédito (Fase 3). Compras de cartão apontam para o cartão e caem
  // numa fatura; o pagamento da fatura é um TRANSFER com invoiceId (regra 5.6).
  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id])
  invoiceId    String?
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id])
  purchaseId   String?
  purchase     Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  installmentNumber Int?
  installmentTotal  Int?

  // Recorrência (Fase 5). Previstos gerados por uma regra apontam para ela.
  // SetNull: apagar a regra preserva o histórico já efetivado.
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  // Reembolso (regra 5.13): o estorno é um INCOME vinculado ao gasto original.
  // Credita a conta, abate o gasto da categoria e NÃO conta como receita.
  // Restrict: o banco impede apagar o gasto deixando estorno órfão — o serviço
  // remove os estornos revertendo o saldo antes de excluir o gasto.
  reimbursesTransactionId String?
  reimburses              Transaction?  @relation("Reimbursement", fields: [reimbursesTransactionId], references: [id], onDelete: Restrict)
  reimbursements          Transaction[] @relation("Reimbursement")

  // Importação (Fase 6). `externalId` guarda o FITID do OFX: quando o banco
  // fornece, a duplicata é detectada por igualdade exata, sem heurística.
  externalId      String?
  importRows      ImportRow[] @relation("ImportedTransaction")
  duplicateOf     ImportRow[] @relation("DuplicateMatch")
  forecastMatches ImportRow[] @relation("ForecastMatch")

  splits TransactionSplit[]
  tags   TransactionTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, accountId, date])
  @@index([userId, categoryId, date])
  @@index([invoiceId])
  @@index([userId, recurringRuleId, date])
  @@index([userId, status, date])
  @@index([reimbursesTransactionId])
  @@index([externalId])
}

// ─── Cartões e faturas (Fase 3) ────────────────────────────────────────────────

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  PARTIAL
}

model CreditCard {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nickname   String
  brand      String?
  last4      String?
  limitCents BigInt
  closingDay Int
  dueDay     Int
  color      String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  defaultPaymentAccountId String?
  defaultPaymentAccount   Account? @relation("CardDefaultPayment", fields: [defaultPaymentAccountId], references: [id])

  invoices     Invoice[]
  purchases    Purchase[]
  transactions Transaction[]

  @@index([userId])
}

model Invoice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  creditCardId   String
  creditCard     CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  referenceMonth String // "yyyy-MM" do vencimento (regra 5.3: fatura de agosto fecha 28/07)
  closingDate    DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(OPEN)
  paidCents      BigInt        @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transactions Transaction[]

  @@unique([creditCardId, referenceMonth])
  @@index([creditCardId])
  @@index([userId, dueDate])
}

model Purchase {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  creditCardId     String
  creditCard       CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  description      String
  totalCents       BigInt
  installmentTotal Int
  purchaseDate     DateTime
  categoryId       String?
  category         Category?  @relation(fields: [categoryId], references: [id])
  createdAt        DateTime   @default(now())

  transactions Transaction[]

  @@index([userId])
}

model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  amountCents   BigInt
}

model TransactionTag {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

// ─── Recorrências, orçamento e metas (Fase 5) ─────────────────────────────────

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Regra 5.11: gera lançamentos previstos (status = FORECAST) até a data final
/// ou até o horizonte rolante. O previsto vira efetivado quando o usuário
/// confirma. Nesta fase o template cobre conta (despesa/receita/transferência).
model RecurringRule {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  description String
  type        TransactionType
  amountCents BigInt
  frequency   RecurrenceFrequency
  /// Dia do mês nas frequências mensais; null = usa o dia do startDate.
  dayOfMonth  Int?
  startDate   DateTime
  endDate     DateTime?
  active      Boolean             @default(true)
  notes       String?

  accountId String?
  account   Account? @relation("RecurringAccount", fields: [accountId], references: [id])

  fromAccountId String?
  fromAccount   Account? @relation("RecurringFrom", fields: [fromAccountId], references: [id])
  toAccountId   String?
  toAccount     Account? @relation("RecurringTo", fields: [toAccountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  lastGeneratedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions Transaction[]

  @@index([userId, active])
}

// ─── Importação (Fase 6) ──────────────────────────────────────────────────────

enum ImportFormat {
  OFX
  QIF
  CSV
}

enum ImportStatus {
  /// Arquivo recebido, job ainda não pegou.
  UPLOADED
  PARSING
  /// Só CSV: precisa que o usuário diga qual coluna é o quê.
  NEEDS_MAPPING
  /// Linhas em staging, esperando revisão e confirmação.
  REVIEW
  CONFIRMED
  FAILED
}

enum ImportRowStatus {
  /// Vai ser importada (padrão).
  PENDING
  /// Parece já existir no banco (regra 5.12).
  DUPLICATE
  /// Usuário decidiu não importar.
  IGNORED
  IMPORTED
}

/// Regra 5.12 — staging da importação. NADA vira lançamento antes da
/// confirmação final: até lá tudo vive aqui.
model ImportBatch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename   String
  format     ImportFormat
  status     ImportStatus @default(UPLOADED)
  /// Conteúdo do arquivo (base64). Vai para o R2 na Fase 9.
  rawContent String       @db.Text
  fileSize   Int

  accountId            String?
  account              Account? @relation(fields: [accountId], references: [id])
  /// Conta detectada no arquivo (nº do OFX), para conferência do usuário.
  detectedAccountLabel String?

  /// Mapeamento de colunas do CSV escolhido pelo usuário.
  columnMapping Json?
  /// Só CSV: cabeçalhos + 5 primeiras linhas, para a tela de mapeamento.
  preview       Json?

  totalRows     Int @default(0)
  duplicateRows Int @default(0)
  importedRows  Int @default(0)
  /// 0–100, atualizado pelo job para a UI acompanhar.
  progress      Int @default(0)

  error       String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rows ImportRow[]

  @@index([userId, status])
}

/// Uma linha do arquivo em staging, já normalizada.
model ImportRow {
  id         String      @id @default(cuid())
  batchId    String
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lineNumber Int

  /// Linha crua como veio do arquivo (auditoria e remapeamento de CSV).
  raw Json

  date                DateTime
  amountCents         BigInt
  description         String
  originalDescription String
  type                TransactionType
  /// FITID do OFX quando existe: dedupe exato.
  externalId          String?

  status ImportRowStatus @default(PENDING)

  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id])
  /// Sugestão do motor de CategoryRule (o usuário confirma ou troca).
  suggestedCategoryId String?
  /// Regra que gerou a sugestão, para mostrar "por que veio assim".
  matchedRuleId       String?

  /// Lançamento existente que parece ser o mesmo (regra 5.12).
  duplicateOfId  String?
  duplicateOf    Transaction? @relation("DuplicateMatch", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicateScore Float?

  /// Regra 5.11 — previsto que esta linha veio efetivar. Na confirmação o
  /// previsto vira lançamento real em vez de nascer um duplicado ao lado dele.
  matchedForecastId String?
  matchedForecast   Transaction? @relation("ForecastMatch", fields: [matchedForecastId], references: [id], onDelete: SetNull)

  /// Preenchido na confirmação — a prova de que a linha virou lançamento.
  transactionId String?
  transaction   Transaction? @relation("ImportedTransaction", fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([batchId, status])
  @@index([batchId, lineNumber])
}

/// Regra 5.12 — padrão de descrição (+ faixa de valor opcional) → categoria.
/// Aprendida na revisão da importação e reaplicada nas próximas.
model CategoryRule {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pattern      String
  minCents     BigInt?
  maxCents     BigInt?
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Quantas vezes a regra já categorizou algo (ordena as mais úteis).
  appliedCount Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, pattern, categoryId])
  @@index([userId, active])
}

/// Regra 5.10: limite mensal por categoria.
model Budget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// "yyyy-MM" no fuso de São Paulo.
  month      String
  limitCents BigInt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

// ─── Investimentos (Fase 8) ───────────────────────────────────────────────────

enum InvestmentClass {
  STOCKS
  REITS
  FIXED_INCOME
  TREASURY
  FUNDS
  CRYPTO
  INTERNATIONAL
  OTHER
}

enum InvestmentSource {
  MANUAL
  SYNCED
}

enum InvestmentTransactionType {
  /// Aporte: compra de cotas/ações.
  BUY
  /// Resgate: venda.
  SELL
}

/// Posição em carteira. `quantity` é inteiro na escala 1e-8 (cripto precisa de
/// fração), e o dinheiro segue a regra 5.1: inteiro em centavos.
///
/// `investedCents` é a FONTE DA VERDADE do custo (soma exata do que foi pago);
/// `avgPriceCents` é derivado dele a cada mudança, para leitura O(1) na tela.
model Investment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticker String
  name   String?
  class  InvestmentClass

  quantity      BigInt @default(0)
  investedCents BigInt @default(0)
  avgPriceCents BigInt @default(0)

  currentPriceCents BigInt           @default(0)
  priceUpdatedAt    DateTime?
  source            InvestmentSource @default(MANUAL)

  /// Lucro/prejuízo já realizado em vendas (regra do preço médio brasileiro).
  realizedGainCents BigInt @default(0)

  notes     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InvestmentTransaction[]
  prices       PriceHistory[]

  @@unique([userId, ticker])
  @@index([userId, class])
}

/// Aporte ou resgate. Quando há conta de origem/destino, o movimento de
/// dinheiro vira um `Transaction` do tipo TRANSFER — que não conta como
/// receita nem despesa (regra 5.7): comprar ativo não é gasto.
model InvestmentTransaction {
  id           String                    @id @default(cuid())
  investmentId String
  investment   Investment                @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  type         InvestmentTransactionType

  quantity   BigInt
  priceCents BigInt
  feesCents  BigInt   @default(0)
  totalCents BigInt
  date       DateTime

  /// Conta que pagou o aporte / recebeu o resgate. Opcional: dá para cadastrar
  /// posição antiga sem reconstruir o histórico bancário.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  /// Lançamento gerado quando houve conta (para desfazer junto).
  transactionId String?

  /// Preço médio e lucro realizado logo após esta operação (auditoria).
  avgPriceAfterCents BigInt @default(0)
  realizedGainCents  BigInt @default(0)

  notes     String?
  createdAt DateTime @default(now())

  @@index([investmentId, date])
}

/// Cotação diária por ativo. Cada atualização manual de preço grava um ponto,
/// e é daqui que sai a evolução patrimonial da carteira.
model PriceHistory {
  id           String     @id @default(cuid())
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  date         DateTime
  priceCents   BigInt
  createdAt    DateTime   @default(now())

  @@unique([investmentId, date])
  @@index([date])
}

/// Alvo de alocação por classe, para a tela mostrar o desvio.
model AllocationTarget {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  class         InvestmentClass
  targetPercent Int
  updatedAt     DateTime        @updatedAt

  @@id([userId, class])
}

/// Regra 5.9: a meta é vinculada a uma conta/investimento que JÁ EXISTE. Ela não
/// move dinheiro nem cria saldo paralelo — o progresso é lido do saldo vinculado.
model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                     String
  targetCents              BigInt
  deadline                 DateTime?
  linkedAccountId          String
  linkedAccount            Account   @relation("GoalAccount", fields: [linkedAccountId], references: [id])
  monthlyContributionCents BigInt?
  archived                 Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([linkedAccountId])
  @@index([userId])
}

// ─── Backup (Fase 9) ──────────────────────────────────────────────────────────

enum RestoreStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Restauração de backup em andamento. O arquivo enviado fica em `content` só
/// enquanto o job roda e é apagado ao terminar — decisão do dono: nesta fase não
/// existe storage, então nada de arquivo sobrevive no servidor.
model RestoreJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       RestoreStatus @default(PENDING)
  /// 'replace' apaga antes de gravar; 'merge' grava por cima.
  mode         String        @default("replace")
  progress     Int           @default(0)
  totalRecords Int           @default(0)
  /// Quantas linhas entraram por seção, para a tela mostrar o resultado.
  restored     Json?
  error        String?
  content      String?       @db.Text
  createdAt    DateTime      @default(now())
  finishedAt   DateTime?

  @@index([userId, createdAt])
}
